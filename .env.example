# Vagus-Decipher Environment Variables
# Neural Decoding of Vagus Nerve Electrophysiology for Real-Time Prediction of Systemic Inflammatory Storms

# ============= AWIE Parameters (Adaptive Wavelet Isolation Engine) =============
VAGUS_AWIE_WAVELET=morlet
VAGUS_AWIE_SIGMA=6
VAGUS_AWIE_F_MIN=300
VAGUS_AWIE_F_MAX=3000
VAGUS_AWIE_FS=30000

# ============= Spatiotemporal Beamformer =============
VAGUS_BEAMFORMER_N_CONTACTS=6
VAGUS_BEAMFORMER_CV_MIN=0.2
VAGUS_BEAMFORMER_CV_MAX=2.0
VAGUS_BEAMFORMER_INTERFERENCE_REJECTION=20

# ============= NISSD Parameters (Neuro-Immune State-Space Decoder) =============
VAGUS_NISSD_HIDDEN_DIM=256
VAGUS_NISSD_LAYERS=4
VAGUS_NISSD_STATE_DIM=7
VAGUS_NISSD_PHYSICS_LAMBDA=5.0
VAGUS_NISSD_TIMING_LAMBDA=12.0

# ============= ISI Predictor Parameters (Inflammatory Storm Index) =============
VAGUS_ISI_INTEGRATION_WINDOW=30
VAGUS_ISI_BETA=0.08
VAGUS_ISI_ALERT_THRESHOLD=0.65
VAGUS_ISI_WARN_HORIZON_MIN=45

# ============= Clinical Alert Thresholds =============
VAGUS_ALERT_LOW=0.35
VAGUS_ALERT_MODERATE=0.55
VAGUS_ALERT_HIGH=0.75
VAGUS_ALERT_CRITICAL=0.90

# ============= Hardware Interface =============
VAGUS_INTERFACE_TYPE=implanted_cuff
VAGUS_SAMPLING_RATE=30000
VAGUS_N_CHANNELS=6

# ============= Logging =============
VAGUS_LOG_LEVEL=INFO
VAGUS_SAVE_RESULTS=true
VAGUS_RESULTS_DIR=./results

# ============= API Keys (Optional) =============
# GITHUB_TOKEN=your_token_here
# GITLAB_TOKEN=your_token_here
# PYPI_TOKEN=your_pypi_token_here
